{
  "name": "codex-notify",
  "displayName": "Codex Notify",
  "description": "Windows completion notifications for Codex in WSL, with session titles and links back to the originating VS Code window.",
  "version": "0.2.1",
  "publisher": "Metric-cell",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Requires WSL and local access to the Codex session database."
    }
  },
  "scripts": {
    "test": "node --test test/extension.test.js && python3 -B -m unittest discover -s test -p 'test_*.py'",
    "package": "vsce package --no-dependencies"
  },
  "keywords": [
    "codex",
    "notifications",
    "wsl"
  ],
  "files": [
    "extension.js",
    "notify_windows.py",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codex-notify.copyConfiguration",
        "title": "Copy Codex Configuration",
        "category": "Codex Notify"
      },
      {
        "command": "codex-notify.testNotification",
        "title": "Send Test Notification",
        "category": "Codex Notify"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0"
  },
  "author": {
    "name": "Metric-cell",
    "url": "https://github.com/Metric-cell"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Metric-cell/codex-notify.git"
  },
  "homepage": "https://github.com/Metric-cell/codex-notify#readme",
  "bugs": {
    "url": "https://github.com/Metric-cell/codex-notify/issues"
  }
}
